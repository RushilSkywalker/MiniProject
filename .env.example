# Copy to .env at the repository root. Restart the backend after changes.
APP_MODE=demo
# Required in live mode only; never add a VITE_ prefix to secrets.
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4.1-mini
OPENAI_VALIDATION_MODEL=gpt-4.1-mini
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
# Live schema only. Demo always loads its own configuration.
GRAPH_SCHEMA_PATH=backend/config/live-schema.json
MAX_RESULT_ROWS=100
NEO4J_QUERY_TIMEOUT_MS=10000
PORT=3001
# Used by development CORS (Vite also proxies /api).
FRONTEND_ORIGIN=http://127.0.0.1:5173
