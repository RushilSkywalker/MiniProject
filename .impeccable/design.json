  "narrative": {
    "northStar": "The Classroom Workbench",
    "overview": "The classroom workbench is a light Operate interface: off-white canvas, white panels, green actions, and quiet separators. Its restrained density keeps questions, generated code, review, and results legible as a single working surface. This description preserves the incumbent direction; it is an implementation decision, not a newly claimed user preference.\n\nFlat surfaces and a compact type hierarchy favor inspection. The dark query panel provides the strongest tonal distinction. Locally bundled Manrope supplies the interface voice; system monospace identifies code and parameter values.",
    "keyCharacteristics": [
      "Light canvas with forest-green actions.",
      "Flat bordered panels and a distinct dark code surface.",
      "Two columns on desktop; a single reading-order stack on mobile.",
      "Explicit asynchronous feedback and visible keyboard focus."
    ],
    "rules": [],
    "dos": [
      "Do use the primary green for the main action and positive review cues.",
      "Do retain visible focus rings, labeled inputs, and textual state descriptions.",
      "Do preserve wrapping for code and questions and horizontal scrolling for result tables.",
      "Do keep demo and live labels explicit."
    ],
    "donts": [
      "Don't add panel shadows to this flat workbench.",
      "Don't make the whole workspace dark; reserve the dark container treatment for code.",
